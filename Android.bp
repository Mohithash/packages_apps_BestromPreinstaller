android_app {
    name: "BestromPreinstaller",

    srcs: ["src/**/*.java"],

    sdk_version: "system_current",
    certificate: "platform",
    privileged: true,
    product_specific: true,

    manifest: "AndroidManifest.xml",

    required: ["privapp_allowlist_org.bestrom.preinstaller.xml"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp_allowlist_org.bestrom.preinstaller.xml",
    product_specific: true,
    sub_dir: "permissions",
    src: "privapp_allowlist_org.bestrom.preinstaller.xml",
    filename_from_src: true,
}
